# Exemplo de variáveis de ambiente para o pipeline ENEM
# Copie para .env e preencha (NAO commite o .env)

# Pasta onde estão os arquivos brutos (microdados). Padrão: ../dados_brutos
PASTA_BRUTOS=../dados_brutos

# Pasta de trabalho do pipeline (onde ficam `dados/` e `agregados`)
PASTA_DADOS=./dados

# Pasta onde os parquets agregados serão escritos
PASTA_AGREGADOS=./dados/agregados

# Diretório público onde o frontend espera os dados (docs/data)
WEB_DATA=./docs/data

# SGDE — cookie de sessao (DevTools > Network > Cookie, logado em sgde.ms.gov.br/sgde/relatorio)
SGDE_COOKIE=

# Opcao A (recomendada): cookie _aio_session do navegador
AIO_SESSION=
# Opcao B: login e-mail/senha em https://www.aio.com.br/users/sign_in
AIO_EMAIL=
AIO_PASSWORD=

# e-ms — upload de grupo de destinatarios (scripts/upload_grupo_destinatarios_ems.py)
# Copie do DevTools > Network ao usar https://e-ms.ms.gov.br logado
EMS_PROXY_AUTH=
EMS_SESSION_ID=
EMS_TENANT_ID=virtus-protocolo-UIVII
EMS_TARGET_URL=http://k1528-prd-ems-api-ad:3000
EMS_UNIDADE=4199
EMS_CRIADOR_CPF=
EMS_CRIADOR_NOME=
EMS_CRIADOR_EMAIL=
